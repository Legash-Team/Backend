{
  "name": "legash-backend",
  "version": "1.0.0",
  "description": "Legash - Smart Blood Donation Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:superadmin": "node src/seed/seedSuperAdmin.js",
    "seed:donor": "node src/seed/seedDonor.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "node scripts/check-contract.js",
    "test:contract:e2e": "node scripts/run-contract-tests.js",
    "test:newman": "newman run ./legash_docs/legash_full_test_collection.json --env-var \"baseUrl=http://localhost:3000\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "newman": "^6.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "flatted": "^3.3.2",
    "node-forge": "^1.3.1",
    "qs": "^6.14.0",
    "underscore": "^1.13.7",
    "uuid": "^11.1.1"
  }
}
